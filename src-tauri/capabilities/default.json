{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Capabilities granted to the main Poise window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "poise-backend", "sidecar": true }]
    }
  ]
}
